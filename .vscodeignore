# Dev-only files — never shipped in the VSIX. Verify with: npx @vscode/vsce ls
.git
.gitignore
.github/**
.claude/**
.vscode/**
node_modules/**
scripts/**
tests/**
docs/**
themes/_src/**
themes/_snapshot/**
samples/**
images/icon.svg
# README images are served from the GitHub repo (vsce rewrites relative URLs); only the icon ships
images/palette-*.png
images/screenshot-*.png
*.vsix
package-lock.json
*.md
!README.md
!CHANGELOG.md
.DS_Store
